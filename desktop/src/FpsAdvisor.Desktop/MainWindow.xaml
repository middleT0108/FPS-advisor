<Window x:Class="FpsAdvisor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Advisor - Công cụ Chẩn đoán &amp; Tối ưu PC Gaming"
        Height="820" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextLightBrush}">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer Status -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="FPS Advisor Desktop" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="Đo lường an toàn • 0% Hook/Inject • Chuẩn Anti-Cheat Vanguard/VAC/ACE" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#064E3B" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" BorderBrush="#059669" BorderThickness="1">
                        <TextBlock Text="✓ 100% Anti-Cheat Safe (ETW)" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                    </Border>
                    <Button x:Name="BtnHeaderSync" Content="Gửi dữ liệu lên Web" Style="{StaticResource PrimaryButton}" Click="BtnHeaderSync_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Controls -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="{StaticResource CardDarkBrush}" CornerRadius="8,8,0,0" Margin="0,0,4,0" Padding="14,10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1,1,1,0">
                                    <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="TextElement.Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- TAB MỚI: TỐI ƯU FPS CHO MÁY (REALTIME FPS & ONE-CLICK BOOST) -->
            <TabItem Header="⚡ Tối ưu FPS cho máy" IsSelected="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0" Grid.IsSharedSizeScope="True">
                        <!-- Top HUD Bar: Realtime FPS Monitoring -->
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Giám sát FPS Game thời gian thực &amp; Tình trạng máy" FontSize="16" FontWeight="Bold" Foreground="White" />
                                        <TextBlock Text="Theo dõi độ trễ khung hình, 1% Low và nhiệt độ linh kiện trong lúc chơi game (ETW Safe Pipeline)." FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Game đang chọn:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox x:Name="CboActiveGame" Width="220" Padding="8,5" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource BorderDarkBrush}" SelectionChanged="CboActiveGame_SelectionChanged">
                                            <ComboBoxItem Content="Valorant" IsSelected="True" Tag="VALORANT-Win64-Shipping" />
                                            <ComboBoxItem Content="Counter-Strike 2" Tag="cs2" />
                                            <ComboBoxItem Content="Liên Minh Huyền Thoại" Tag="League of Legends" />
                                            <ComboBoxItem Content="Delta Force" Tag="DeltaForceClient-Win64" />
                                        </ComboBox>
                                        <Button x:Name="BtnToggleRealtimeFps" Content="Bật Giám sát Realtime" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="BtnToggleRealtimeFps_Click" />
                                    </StackPanel>
                                </Grid>

                                <!-- Live Metrics Dashboard -->
                                <Border Background="#090E1A" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Big FPS Display -->
                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <TextBlock Text="FPS TỨC THỜI (REALTIME)" FontSize="10" FontWeight="Bold" Foreground="#34D399" />
                                            <TextBlock x:Name="TxtRealtimeFps" Text="-- FPS" FontSize="36" FontWeight="Black" Foreground="#10B981" Margin="0,4,0,0" />
                                            <TextBlock x:Name="TxtRealtimeGameStatus" Text="Chưa kích hoạt giám sát" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>

                                        <!-- Avg FPS -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="FPS Trung bình" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtRealtimeAvgFps" Text="-- FPS" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- 1% Low -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="1% Low FPS" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtRealtime1Low" Text="-- FPS" FontSize="20" FontWeight="Bold" Foreground="#818CF8" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Frametime -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="Frametime" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtRealtimeFrametime" Text="-- ms" FontSize="20" FontWeight="Bold" Foreground="#FBBF24" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- CPU Temp -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="Nhiệt độ CPU" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtRealtimeCpuTemp" Text="-- °C" FontSize="20" FontWeight="Bold" Foreground="#F472B6" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- GPU Temp -->
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                            <TextBlock Text="Nhiệt độ GPU" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtRealtimeGpuTemp" Text="-- °C" FontSize="20" FontWeight="Bold" Foreground="#60A5FA" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Bottom Section: One-Click Optimizer -->
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Tối ưu hóa tức thì cho PC Gaming (One-Click Boost)" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="Tự động tinh chỉnh cấu hình máy, dọn dẹp RAM rác, và ưu tiên tối đa tài nguyên cho game đang chơi." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Action Checklist -->
                                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                        <TextBlock Text="Các tác vụ tối ưu sẽ thực hiện:" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="✓ Kích hoạt Windows High Performance Power Plan (Khóa xung boost CPU)" FontSize="12" Foreground="#34D399" Margin="0,2" />
                                            <TextBlock Text="✓ Kích hoạt Windows Game Mode (Ưu tiên GPU scheduling)" FontSize="12" Foreground="#34D399" Margin="0,2" />
                                            <TextBlock Text="✓ Giải phóng bộ nhớ RAM đệm (Windows WorkingSet Trim) của các app nền" FontSize="12" Foreground="#34D399" Margin="0,2" />
                                            <TextBlock Text="✓ Đặt Process Priority của Game sang mức 'High' trong Task Scheduler" FontSize="12" Foreground="#34D399" Margin="0,2" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Big Optimize Button -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="BtnQuickOptimize" Content="⚡ TỐI ƯU FPS NGAY" Style="{StaticResource PrimaryButton}" Height="50" FontSize="15" FontWeight="Black" Click="BtnQuickOptimize_Click" Margin="0,0,0,10" />
                                        <Button x:Name="BtnQuickUndo" Content="Hoàn tác / Khôi phục ban đầu" Style="{StaticResource SecondaryButton}" IsEnabled="False" Click="BtnQuickUndo_Click" />
                                    </StackPanel>
                                </Grid>

                                <!-- Status Result Banner -->
                                <Border x:Name="BorderQuickOptStatus" Visibility="Collapsed" Background="#064E3B" CornerRadius="8" Padding="12" BorderBrush="#059669" BorderThickness="1">
                                    <TextBlock x:Name="TxtQuickOptStatus" Text="Đã tối ưu thành công!" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 1: QUÉT CẤU HÌNH -->
            <TabItem Header="1. Quét Cấu hình">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Thông số phần cứng chi tiết của máy" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="BtnRescan" Content="Quét lại cấu hình" Style="{StaticResource SecondaryButton}" Click="BtnRescan_Click" />
                        </Grid>

                        <!-- Hardware Cards Grid -->
                        <UniformGrid Columns="2" Rows="3" Margin="0,0,0,16">
                            <!-- CPU -->
                            <Border Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="16" Margin="0,0,8,12" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="VI XỬ LÝ (CPU)" FontWeight="Bold" Foreground="#818CF8" FontSize="12" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TxtCpuName" Text="Đang quét..." FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtCpuDetails" Text="..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- GPU -->
                            <Border Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="16" Margin="8,0,0,12" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CARD ĐỒ HỌA (GPU)" FontWeight="Bold" Foreground="#C084FC" FontSize="12" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TxtGpuName" Text="Đang quét..." FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtGpuDetails" Text="..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="16" Margin="0,0,8,12" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="BỘ NHỚ RAM" FontWeight="Bold" Foreground="#34D399" FontSize="12" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TxtRamTotal" Text="Đang quét..." FontSize="14" FontWeight="Bold" />
                                    <TextBlock x:Name="TxtRamDetails" Text="..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Storage -->
                            <Border Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="16" Margin="8,0,0,12" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Ổ ĐĨA LƯU TRỮ" FontWeight="Bold" Foreground="#FBBF24" FontSize="12" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TxtDiskModel" Text="Đang quét..." FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TxtDiskType" Text="..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Display -->
                            <Border Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="16" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="MÀN HÌNH HIỂN THỊ" FontWeight="Bold" Foreground="#60A5FA" FontSize="12" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TxtDisplayRes" Text="Đang quét..." FontSize="14" FontWeight="Bold" />
                                    <TextBlock x:Name="TxtDisplayRefresh" Text="..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Windows OS -->
                            <Border Background="{StaticResource CardDarkBrush}" CornerRadius="10" Padding="16" Margin="8,0,0,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="HỆ ĐIỀU HÀNH &amp; THIẾT LẬP" FontWeight="Bold" Foreground="#F472B6" FontSize="12" Margin="0,0,0,6" />
                                    <TextBlock x:Name="TxtOsName" Text="Đang quét..." FontSize="14" FontWeight="Bold" />
                                    <TextBlock x:Name="TxtOsSettings" Text="..." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: SYNTHETIC BENCHMARK -->
            <TabItem Header="2. Benchmark (30-60s)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Đo đạc hiệu năng CPU, RAM, GPU Compute và Ổ đĩa" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="Kiểm tra tải tối đa trong 30-45 giây để xác định điểm số quy chuẩn và phát hiện tụt xung do nhiệt độ." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                                <ProgressBar x:Name="PbBenchmark" Height="10" Value="0" Maximum="100" Margin="0,0,0,8" Foreground="{StaticResource AccentBrush}" Background="#0F172A" />
                                <TextBlock x:Name="TxtBenchStage" Text="Sẵn sàng chạy kiểm tra..." FontSize="12" Foreground="#818CF8" FontWeight="SemiBold" Margin="0,0,0,16" />

                                <!-- Live Sensors During Benchmark -->
                                <UniformGrid Columns="4" Margin="0,0,0,16">
                                    <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Nhiệt độ CPU" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtLiveCpuTemp" Text="-- °C" FontSize="16" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Nhiệt độ GPU" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtLiveGpuTemp" Text="-- °C" FontSize="16" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Tải CPU" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtLiveCpuLoad" Text="-- %" FontSize="16" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#0F172A" CornerRadius="8" Padding="10" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Tải GPU" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtLiveGpuLoad" Text="-- %" FontSize="16" FontWeight="Bold" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnStartBenchmark" Content="Bắt đầu chạy Benchmark" Style="{StaticResource PrimaryButton}" Click="BtnStartBenchmark_Click" Margin="0,0,8,0" />
                                    <Button x:Name="BtnCancelBenchmark" Content="Hủy bỏ" Style="{StaticResource DangerButton}" IsEnabled="False" Click="BtnCancelBenchmark_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Benchmark Results Display -->
                        <Border x:Name="BorderBenchResults" Visibility="Collapsed" Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="KẾT QUẢ ĐO ĐẠC ĐẠT ĐƯỢC" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,12" />
                                <UniformGrid Columns="3" Rows="2">
                                    <StackPanel Margin="0,0,8,12">
                                        <TextBlock Text="CPU Đơn nhân" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="TxtResCpuSingle" Text="--" FontSize="18" FontWeight="Bold" Foreground="#818CF8" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,8,12">
                                        <TextBlock Text="CPU Đa nhân" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="TxtResCpuMulti" Text="--" FontSize="18" FontWeight="Bold" Foreground="#818CF8" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,12">
                                        <TextBlock Text="GPU Compute Score" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="TxtResGpu" Text="--" FontSize="18" FontWeight="Bold" Foreground="#C084FC" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Băng thông RAM" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="TxtResRam" Text="-- GB/s" FontSize="18" FontWeight="Bold" Foreground="#34D399" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,8,0">
                                        <TextBlock Text="Nhiệt độ CPU Cao nhất" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="TxtResMaxCpuTemp" Text="-- °C" FontSize="18" FontWeight="Bold" />
                                    </StackPanel>
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="Đánh giá Nghẽn (Bottleneck)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock x:Name="TxtResBottleneck" Text="--" FontSize="14" FontWeight="Bold" Foreground="#FBBF24" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: ĐO FPS THỰC TẾ -->
            <TabItem Header="3. Đo FPS Phiên Chơi (PresentMon)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Đo FPS trực tiếp khi đang trong trận đấu" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="Phương pháp PresentMon hoàn toàn an toàn: Chỉ lắng nghe sự kiện dựng hình ở tầng OS Kernel qua ETW, không can thiệp bộ nhớ hay tiến trình game." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Chọn tựa game:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="CboGameList" Width="220" Padding="8,6" Background="{StaticResource CardDarkBrush}" Foreground="White" BorderBrush="{StaticResource BorderDarkBrush}">
                                            <ComboBoxItem Content="Valorant (VALORANT-Win64-Shipping)" IsSelected="True" Tag="valorant" />
                                            <ComboBoxItem Content="Counter-Strike 2 (cs2)" Tag="cs2" />
                                            <ComboBoxItem Content="Liên Minh Huyền Thoại (League of Legends)" Tag="league-of-legends" />
                                            <ComboBoxItem Content="Delta Force (DeltaForceClient-Win64)" Tag="delta-force" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="Thời lượng đo (Giây):" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                        <Slider x:Name="SliderDuration" Minimum="30" Maximum="300" Value="60" TickFrequency="30" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ElementName=SliderDuration, Path=Value, StringFormat={}{0:0} Giây}" FontSize="11" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <Button x:Name="BtnStartFpsMonitor" Content="Bắt đầu ghi nhận FPS" Style="{StaticResource PrimaryButton}" Click="BtnStartFpsMonitor_Click" />
                                    </StackPanel>
                                </Grid>

                                <!-- Live FPS Display -->
                                <Border Background="#0F172A" CornerRadius="10" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="FPS Tức thời" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtLiveFps" Text="-- FPS" FontSize="26" FontWeight="Black" Foreground="#34D399" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="FPS Trung bình (Avg)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtLiveAvgFps" Text="-- FPS" FontSize="26" FontWeight="Black" Foreground="White" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="1% Low FPS" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtLive1LowFps" Text="-- FPS" FontSize="26" FontWeight="Black" Foreground="#818CF8" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Frametime" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock x:Name="TxtLiveFrametime" Text="-- ms" FontSize="26" FontWeight="Black" Foreground="#FBBF24" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="TxtFpsStatus" Text="Nhấn 'Bắt đầu ghi nhận FPS', sau đó chuyển sang màn hình game chơi bình thường." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: DANH SÁCH ỨNG DỤNG NỀN -->
            <TabItem Header="4. Ứng dụng nền">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Ứng dụng chạy ngầm chiếm nhiều tài nguyên (Chỉ cảnh báo, không tự tắt):" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" />
                                <TextBlock Text="Các tiến trình trình duyệt web, launcher hoặc app chat ngốn CPU/RAM có thể gây hiện tượng micro-stutter." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                                <Border Background="#0F172A" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                    <ItemsControl x:Name="ListHeavyProcesses">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" />
                                                    <TextBlock Grid.Column="1" Text="{Binding MemoryMb, StringFormat={}{0} MB RAM}" Foreground="#818CF8" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Recommendation}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: ĐỒNG BỘ WEBSITE -->
            <TabItem Header="5. Liên kết Website (Sync)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,16,0,0">
                        <Border Background="{StaticResource CardDarkBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Gửi hồ sơ máy &amp; kết quả đo lên Website" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBlock Text="Lấy mã 6 ký tự hiển thị trên trang web (VD: A7X9K2) và dán vào ô bên dưới." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16" />

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Mã liên kết 6 ký tự:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtLinkCode" CharacterCasing="Upper" MaxLength="6" FontSize="18" FontWeight="Bold" Padding="10,6" Background="#0F172A" Foreground="#818CF8" BorderBrush="{StaticResource BorderDarkBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Địa chỉ Website API:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TxtServerUrl" Text="http://localhost:3005" FontSize="14" Padding="10,8" Background="#0F172A" Foreground="White" BorderBrush="{StaticResource BorderDarkBrush}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Consent Checkbox -->
                                <Border Background="#064E3B" CornerRadius="8" Padding="12" BorderBrush="#059669" BorderThickness="1" Margin="0,0,0,16">
                                    <CheckBox x:Name="ChkConsent" IsChecked="True" Foreground="White" FontSize="12">
                                        <TextBlock TextWrapping="Wrap">
                                            Tôi đồng ý chia sẻ thông số phần cứng (CPU, GPU, RAM, điểm benchmark) lên Website FPS Advisor. Tôi hiểu rằng phần mềm KHÔNG thu thập dữ liệu cá nhân, thông tin tài khoản hay file trên máy.
                                        </TextBlock>
                                    </CheckBox>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button x:Name="BtnSubmitToServer" Content="Gửi lên Website ngay" Style="{StaticResource PrimaryButton}" Click="BtnSubmitToServer_Click" Margin="0,0,10,0" />
                                    <Button x:Name="BtnPreviewJson" Content="Xem trước dữ liệu JSON" Style="{StaticResource SecondaryButton}" Click="BtnPreviewJson_Click" Margin="0,0,10,0" />
                                    <Button x:Name="BtnExportOfflineJson" Content="Xuất file JSON (Dùng Offline)" Style="{StaticResource SecondaryButton}" Click="BtnExportOfflineJson_Click" />
                                </StackPanel>

                                <!-- Sync Status Box -->
                                <Border x:Name="BorderSyncStatus" Visibility="Collapsed" Background="#0F172A" CornerRadius="8" Padding="12" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Margin="0,0,0,16">
                                    <TextBlock x:Name="TxtSyncStatus" Text="Trạng thái đồng bộ..." FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Border>

                                <!-- JSON Preview Box -->
                                <TextBox x:Name="TxtJsonPreview" Visibility="Collapsed" Height="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0F172A" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" Padding="10" BorderBrush="{StaticResource BorderDarkBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource CardDarkBrush}" CornerRadius="8" Padding="12,8" Margin="0,16,0,0" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtBottomStatus" Text="Đã sẵn sàng. Quét phần cứng hoàn tất." FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="FPS Advisor v1.0.0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
